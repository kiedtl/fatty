ws            = _{ " " | "\t" }

command       = { SOI ~ ws* ~ token ~ (ws+ ~ token)* ~ ws* ~ EOI }
token         = _{ single_quoted | double_quoted | unquoted }
single_quoted = @{ "'" ~ (!"'" ~ ANY)* ~ "'" }
double_quoted = @{ "\"" ~ ("\\" ~ ANY | (!"\"" ~ ANY))* ~ "\"" }

unquoted = @{
    ( (!(" " | "\t" | "'" | "\"" | "\\") ~ ANY)
    | ("\\" ~ ANY)
    )+
}

